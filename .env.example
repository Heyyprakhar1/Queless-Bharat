# ==============================================================================
# QueueLess Bharat — Root Docker Compose Environment Template
# Copy this file to .env before running `docker compose up`
# ==============================================================================

# Application environment (development | staging | production)
ENVIRONMENT=development

# Host Exposed Ports
FRONTEND_PORT=80
BACKEND_PORT=8000
POSTGRES_PORT=5432

# PostgreSQL Database Credentials (Change passwords in production)
POSTGRES_DB=queless_db
POSTGRES_USER=queless_user
POSTGRES_PASSWORD=queless_password

# Authentication & Security
# Generate secure key in production via: openssl rand -hex 32
AUTH_SECRET_KEY=dev-insecure-secret-key-replace-in-production-min-32-chars-long!
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Startup behavior
RUN_MIGRATIONS=true
SEED_DATA=false
