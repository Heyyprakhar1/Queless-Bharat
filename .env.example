# ==============================================================================
# QueuelessBharat — Root Docker Compose Environment Template
# Copy this file to .env before running `docker compose up`
# ==============================================================================

# Application environment (development | staging | production)
ENVIRONMENT=development

# Host Exposed Ports
FRONTEND_PORT=80
BACKEND_PORT=8000
POSTGRES_PORT=5432

# PostgreSQL Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_DB=queless_db
POSTGRES_USER=queless_user
POSTGRES_PASSWORD=queless_password

# Optional direct database URL override (leave unset to use above params)
# DATABASE_URL=postgresql+asyncpg://queless_user:queless_password@localhost:5432/queless_db

# Authentication & Security
# Generate secure key in production via: openssl rand -hex 32
AUTH_SECRET_KEY=dev-insecure-secret-key-replace-in-production-min-32-chars-long!
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (JSON list format or comma-separated)
ALLOWED_ORIGINS=["http://localhost","http://localhost:80","http://localhost:8080","http://localhost:5173","http://127.0.0.1:5173"]

# Google OpenID Connect Citizen Authentication (M6.2)
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Startup behavior
RUN_MIGRATIONS=true
SEED_DATA=false

# Optional Deterministic Image Overrides
# BACKEND_IMAGE=heyyprakhar1/queuelessbharat-backend:latest
# FRONTEND_IMAGE=heyyprakhar1/queuelessbharat-frontend:latest

