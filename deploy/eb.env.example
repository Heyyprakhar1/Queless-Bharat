# Safe template for EB Compose validation only; placeholders are not credentials.
# Never commit a real .env or include secrets in an EB ZIP.
BACKEND_IMAGE=heyyprakhar1/queuelessbharat-backend:e069a8a-fix1
FRONTEND_IMAGE=heyyprakhar1/queuelessbharat-frontend:e069a8a-fix2
POSTGRES_SERVER=your-private-rds-endpoint.region.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-secret-reference-value
POSTGRES_DB=queless_db
DATABASE_URL=
ENVIRONMENT=production
RUN_MIGRATIONS=true
SEED_DATA=false
AUTH_SECRET_KEY=replace-with-secret-reference-value
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=["https://your-production-domain.example"]
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
