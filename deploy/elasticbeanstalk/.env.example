# Safe template only. Never commit or ZIP a real .env file.
# In EB, use environment properties and Secrets Manager references for secrets.
# Versioned tags are used, not latest; use verified image@sha256 digests for strict immutability.
BACKEND_IMAGE=heyyprakhar1/queuelessbharat-backend:e069a8a-fix1
FRONTEND_IMAGE=heyyprakhar1/queuelessbharat-frontend:e069a8a-fix2

POSTGRES_SERVER=your-private-rds-endpoint.region.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-secrets-manager-value
POSTGRES_DB=queless_db
DATABASE_URL=

ENVIRONMENT=production
RUN_MIGRATIONS=true
SEED_DATA=false
AUTH_SECRET_KEY=replace-with-secrets-manager-value
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=["https://your-production-domain.example"]

GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# VITE_* frontend settings are usually baked into the frontend image at build time.
# Set VITE_API_BASE_URL and VITE_GOOGLE_CLIENT_ID when building/publishing that image.
