# ==============================================================================
# Queueless Bharat — Elastic Beanstalk / RDS Production Environment Template
# ==============================================================================
# Configure these variables in AWS Elastic Beanstalk -> Configuration -> Software -> Environment properties
# DO NOT COMMIT ACTUAL PRODUCTION VALUES OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Runtime Metadata
ENVIRONMENT=production
PROJECT_NAME=QueuelessBharat
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# PostgreSQL RDS Database Configuration
# RDS Endpoint: queuelessbharatdb.c7sa4sawqaue.ap-south-1.rds.amazonaws.com
POSTGRES_SERVER=queuelessbharatdb.c7sa4sawqaue.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=queless_db
POSTGRES_USER=your_rds_master_username
POSTGRES_PASSWORD=your_rds_master_password

# Optional Direct Connection String Override (Leave empty if using POSTGRES_* above)
# DATABASE_URL=postgresql://your_user:your_password@queuelessbharatdb.c7sa4sawqaue.ap-south-1.rds.amazonaws.com:5432/queless_db

# Security & Authentication (Required: minimum 32 characters, cryptographically random)
# Generate via: openssl rand -hex 32
AUTH_SECRET_KEY=your_cryptographically_secure_auth_secret_key_min_32_chars!
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (JSON list format or comma-separated)
# Include your Elastic Beanstalk environment domain and custom domain
ALLOWED_ORIGINS=["http://queueless-bharat.ap-south-1.elasticbeanstalk.com","https://queueless-bharat.ap-south-1.elasticbeanstalk.com"]

# Google OpenID Connect Citizen Authentication (M6.2)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database Lifecycle Management
# Set RUN_MIGRATIONS=true for initial schema deployment or version upgrades
RUN_MIGRATIONS=true
# Always keep SEED_DATA=false in production to prevent inserting demo records
SEED_DATA=false

# Optional Deterministic Docker Image Tags
# BACKEND_IMAGE=heyyprakhar1/queuelessbharat-backend:latest
# FRONTEND_IMAGE=heyyprakhar1/queuelessbharat-frontend:latest
