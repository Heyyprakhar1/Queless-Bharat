# QueueLess Bharat Backend Configuration Template
# Copy this file to .env for local development

# Application Environment (development | staging | production)
ENVIRONMENT=development
PROJECT_NAME="QueueLess Bharat"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security & CORS (comma-separated origins or JSON array)
# Never use wildcard '*' in production
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Authentication & Security
# Generate secure 64-character secret in production using: openssl rand -hex 32
AUTH_SECRET_KEY=dev-insecure-secret-key-replace-in-production-min-32-chars-long!
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=queless_user
POSTGRES_PASSWORD=queless_password
POSTGRES_DB=queless_db

# Optional direct database URL override (leave unset to use above params)
# DATABASE_URL=postgresql+asyncpg://queless_user:queless_password@localhost:5433/queless_db
